# Config for .github/workflows/e2e-kind-pr.yml.
#
# Values must use plain KEY=value syntax. Do not quote values.

# Set true to skip this PR e2e workflow after reading config.
SKIP_E2E=false

# When false, the workflow pulls the images configured below.
# When true, the workflow builds repository-local images before running e2e.
# The frontend-forge build-service image is not built by this repository and is
# still read from FRONTEND_FORGE_IMAGE.
USE_LOCAL_IMAGES=false

KIND_VERSION=v0.31.0

# Optional Kubernetes version. Supported values: 1.23, 1.26, 1.28, 1.30, 1.32, 1.34.
# Leave empty to use kind's default node image.
KUBERNETES_VERSION=1.34

FRONTEND_FORGE_CONTROLLER_IMAGE=docker.io/kubespheredev/frontend-forge-controller:dev
FRONTEND_FORGE_RUNNER_IMAGE=docker.io/spike2044/frontend-forge-runner:dev
FRONTEND_FORGE_IMAGE=docker.io/kubesphere/frontend-forge-console:main

# Set true to also run FrontendExtension packaging/download e2e.
RUN_FE_E2E=true
FRONTEND_EXTENSION_CONTROLLER_IMAGE=docker.io/kubespheredev/frontend-extension-controller:dev
FRONTEND_EXTENSION_PACKAGER_IMAGE=docker.io/kubespheredev/frontend-forge-extension-packager:dev
FRONTEND_EXTENSION_API_IMAGE=docker.io/kubespheredev/frontend-forge-extension-api:dev

# Optional. Leave empty to let scripts/ci-kind-e2e.sh default it to the packager image.
FRONTEND_EXTENSION_PUBLISHER_IMAGE=docker.io/kubespheredev/frontend-forge-extension-publisher:dev
